---
import { Code } from 'astro:components';
import Callout from './Callout.astro';
import { extractSection } from '../lib/regions';
import pythonSource from '../../../harness/python/harness.py?raw';
import goSource from '../../../harness/go/main.go?raw';

interface Props {
  section?: number;
  whole?: boolean;
  goNote?: string;
}

const { section, whole = false, goNote } = Astro.props;
if (!whole && section === undefined) {
  throw new Error('CodeTabs needs either `section={n}` or `whole`');
}
const py = whole ? pythonSource : extractSection(pythonSource, section as number);
const go = whole ? goSource : extractSection(goSource, section as number);
const themes = { light: 'github-light', dark: 'github-dark' } as const;
---

<div class="codetabs" data-codetabs>
  <div class="tabbar">
    <div class="tabs" role="tablist" aria-label="Language">
      <button type="button" role="tab" data-lang="python" aria-selected="true" tabindex="0">Python</button>
      <button type="button" role="tab" data-lang="go" aria-selected="false" tabindex="-1">Go</button>
    </div>
    <button type="button" class="copy" data-copy>Copy</button>
  </div>
  <div role="tabpanel" data-panel="python">
    <Code code={py} lang="python" themes={themes} defaultColor={false} />
  </div>
  <div role="tabpanel" data-panel="go" hidden>
    <Code code={go} lang="go" themes={themes} defaultColor={false} />
    {
      goNote && (
        <Callout kind="go" title="How Go does it">
          {goNote}
        </Callout>
      )
    }
  </div>
</div>

<style is:global>
  .codetabs {
    margin: 24px 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .codetabs .tabbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 0 8px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .codetabs .tabs {
    display: flex;
    gap: 4px;
  }
  .codetabs .tabbar button {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 10px 12px;
    color: var(--muted);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }
  .codetabs .tabs button[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
  .codetabs .tabbar button:hover {
    color: var(--ink);
  }
  .codetabs .tabbar button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .codetabs [role='tabpanel'] > .callout {
    margin: 0;
    border-width: 1px 0 0;
    border-radius: 0;
  }
  .codetabs pre.astro-code {
    margin: 0;
    padding: 16px;
    overflow-x: auto;
    border: 0;
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.55;
    background-color: var(--surface) !important;
  }
  .codetabs pre.astro-code,
  .codetabs pre.astro-code span {
    color: var(--shiki-light);
  }
  /* Same three-state switch as tokens.css. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .codetabs pre.astro-code,
    :root:not([data-theme='light']) .codetabs pre.astro-code span {
      color: var(--shiki-dark);
    }
  }
  :root[data-theme='dark'] .codetabs pre.astro-code,
  :root[data-theme='dark'] .codetabs pre.astro-code span {
    color: var(--shiki-dark);
  }
</style>

<script>
  import { LANG_EVENT as EVENT, LANG_KEY as KEY, pickLang, readLang, type Lang } from '../lib/lang';

  function apply(lang: Lang) {
    document.querySelectorAll<HTMLElement>('[data-codetabs]').forEach((root) => {
      root.querySelectorAll<HTMLElement>('[role="tab"]').forEach((tab) => {
        const on = tab.dataset.lang === lang;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
      });
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== lang;
      });
    });
  }

  function choose(lang: Lang) {
    try {
      localStorage.setItem(KEY, lang);
    } catch {
      // choice still syncs in-page via the event
    }
    window.dispatchEvent(new CustomEvent(EVENT, { detail: lang }));
  }

  function selectText(el: Element) {
    const sel = window.getSelection();
    if (!sel) return;
    const range = document.createRange();
    range.selectNodeContents(el);
    sel.removeAllRanges();
    sel.addRange(range);
  }

  window.addEventListener(EVENT, (e) => apply(pickLang((e as CustomEvent<string>).detail ?? null)));
  apply(readLang());

  document.querySelectorAll<HTMLElement>('[data-codetabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLElement>('[role="tab"]'));
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => choose(pickLang(tab.dataset.lang ?? null)));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        choose(pickLang(next.dataset.lang ?? null));
        next.focus();
      });
    });

    const copy = root.querySelector<HTMLButtonElement>('[data-copy]');
    copy?.addEventListener('click', () => {
      const panel = root.querySelector<HTMLElement>('[data-panel]:not([hidden])');
      const pre = panel?.querySelector('pre');
      if (!pre) return;
      navigator.clipboard.writeText(pre.textContent ?? '').then(
        () => {
          copy.textContent = 'Copied';
          setTimeout(() => (copy.textContent = 'Copy'), 1500);
        },
        () => selectText(pre),
      );
    });
  });
</script>
