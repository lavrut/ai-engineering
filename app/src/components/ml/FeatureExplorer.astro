---
// Build-time wrapper: passes the production model as forExplorer shrinks it (full vocabulary
// and idf, class weights for the 1,200 most influential words, 4 significant figures), its
// arrays packed into strings, and one 2022 test complaint per category as presets: 142 KB.
// The full model never ships.
import FeatureExplorerIsland from './FeatureExplorer.tsx';
import { loadMlData } from '../../lib/mlData';
import { featureExplorerProps } from '../../lib/mlAids';

const props = featureExplorerProps(loadMlData());
---

<FeatureExplorerIsland client:visible {...props} />
