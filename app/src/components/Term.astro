---
import { glossary } from '../data/glossary';

interface Props {
  t: keyof typeof glossary;
}

const { t } = Astro.props;
const definition: string = glossary[t];
// Stable ids for aria-describedby: one per rendered instance.
const g = globalThis as { __aieTermSeq?: number };
g.__aieTermSeq = (g.__aieTermSeq ?? 0) + 1;
const id = `term-${g.__aieTermSeq}`;
---

<span class="term" tabindex="0" aria-describedby={id}>
  <slot>{t}</slot><span class="term-def" role="tooltip" id={id}>{definition}</span>
</span>

<style>
  .term {
    position: relative;
    border-bottom: 1px dotted var(--muted);
    cursor: help;
  }
  .term-def {
    position: absolute;
    left: 0;
    top: calc(100% + 6px);
    z-index: 10;
    width: max-content;
    max-width: min(32ch, 80vw);
    padding: 8px 10px;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: 400;
    line-height: 1.45;
    /* display:none (not visibility:hidden) so a closed tooltip takes no layout
       space and can never widen the page; aria-describedby still reads it. */
    display: none;
  }
  .term:hover .term-def,
  .term:focus .term-def {
    display: block;
  }
</style>

<script>
  // An open tooltip starts at the term's left edge. Near the right side of a
  // narrow screen that would overflow, so shift it left to stay in view.
  const GUTTER = 8;

  function place(term: HTMLElement) {
    const def = term.querySelector<HTMLElement>('.term-def');
    if (!def) return;
    def.style.left = '';
    const r = def.getBoundingClientRect();
    if (r.width === 0) return; // not shown
    const overflow = r.right - (document.documentElement.clientWidth - GUTTER);
    if (overflow > 0) def.style.left = `${-Math.min(overflow, Math.max(0, r.left - GUTTER))}px`;
  }

  function onShow(e: Event) {
    const term = (e.target as Element | null)?.closest?.<HTMLElement>('.term');
    if (term) place(term);
  }

  document.addEventListener('mouseover', onShow);
  document.addEventListener('focusin', onShow);
</script>
