---
// Build-time wrapper: the judge's verdicts on the 30 labelled replies in both
// rubric orders (found by cache key, R25), the drafted labels and a fingerprint
// of each reply so the island can apply the learner's stored labels (R30).
import AgreementViewIsland from './AgreementView.tsx';
import { loadLlmsData } from '../../lib/llmsData';
import { judgeKey } from '../../lib/llmsKey';
import { JUDGE_MODEL, agreementProps } from '../../lib/llmsAids';

const data = loadLlmsData();
const props = agreementProps(data, (ticket, reply, order) => judgeKey(ticket, reply, order, JUDGE_MODEL, data.prompts));
---

<AgreementViewIsland client:visible {...props} />
