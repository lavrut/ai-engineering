---
// Build-time wrapper: finds recorded judge verdicts by cache key (R25). By default
// only the 30 labelled replies in both rubric orders (DEFAULT_JUDGE_GROUPS, R30);
// a lesson opts in to the judged test-split replies with groups={['v2_rules']}.
// Passes ticket text once per ticket, each reply and its verdicts with reasons;
// no runs or saved lines.
import JudgeCardIsland from './JudgeCard.tsx';
import { loadLlmsData } from '../../lib/llmsData';
import { judgeKey } from '../../lib/llmsKey';
import { DEFAULT_JUDGE_GROUPS, JUDGE_MODEL, judgeCardProps, type JudgeCaseGroup } from '../../lib/llmsAids';

interface Props {
  /** The case shown first: a label id (r001) or prompt:ticket (v2_rules:t041). */
  initial?: string;
  /** Which cases to offer: 'labelled', 'v1_basic', 'v2_rules'. Default ['labelled']; each test-split group adds ~25 KB. */
  groups?: JudgeCaseGroup[];
}

const data = loadLlmsData();
const props = judgeCardProps(data, (ticket, reply, order) => judgeKey(ticket, reply, order, JUDGE_MODEL, data.prompts), {
  initial: Astro.props.initial,
  groups: Astro.props.groups ?? DEFAULT_JUDGE_GROUPS,
});
---

<JudgeCardIsland client:visible {...props} />
