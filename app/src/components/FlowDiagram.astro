---
// Build-time wrapper for the FlowDiagram island: picks the diagram by key and
// passes along only the source sections that its steps link to. A step's
// `code.source` (default 'harness') names a source in lib/codeSources.ts, and
// `code.goSection` the Go section where the Go file numbers its own.
import FlowDiagramIsland from './FlowDiagram.tsx';
import { resolveCode } from '../lib/codeSourceText';
import { codeKey } from '../lib/diagram';
import { agentPatterns } from '../data/diagrams/agent-patterns';
import { dataFabric } from '../data/diagrams/data-fabric';
import { evalPipeline } from '../data/diagrams/eval-pipeline';
import { inspectPipeline } from '../data/diagrams/inspect-pipeline';
import { harnessFlow } from '../data/diagrams/harness-flow';
import { mcpArchitecture } from '../data/diagrams/mcp-architecture';
import { mcpClient } from '../data/diagrams/mcp-client';
import { mcpHttp } from '../data/diagrams/mcp-http';
import { mcpOauth } from '../data/diagrams/mcp-oauth';
import { mlLoop } from '../data/diagrams/ml-loop';
import { mlPipeline } from '../data/diagrams/ml-pipeline';
import { replayProxy } from '../data/diagrams/replay-proxy';
import { requestResponse } from '../data/diagrams/request-response';
import { toolRoundtrip } from '../data/diagrams/tool-roundtrip';

const diagrams = {
  'agent-patterns': agentPatterns,
  'data-fabric': dataFabric,
  'eval-pipeline': evalPipeline,
  'harness-flow': harnessFlow,
  'inspect-pipeline': inspectPipeline,
  'mcp-architecture': mcpArchitecture,
  'mcp-client': mcpClient,
  'mcp-http': mcpHttp,
  'mcp-oauth': mcpOauth,
  'ml-loop': mlLoop,
  'ml-pipeline': mlPipeline,
  'replay-proxy': replayProxy,
  'request-response': requestResponse,
  'tool-roundtrip': toolRoundtrip,
} as const;

interface Props {
  diagram: keyof typeof diagrams;
  mode?: 'replay';
}

const { diagram: key, mode } = Astro.props;
const diagram = diagrams[key];
if (!diagram) throw new Error(`FlowDiagram: unknown diagram "${key}"`);

const codePython: Record<string, string> = {};
const codeGo: Record<string, string> = {};
for (const step of diagram.steps) {
  if (!step.code) continue;
  const k = codeKey(step.code);
  const code = resolveCode(step.code);
  codePython[k] = code.python;
  if (code.go !== undefined) codeGo[k] = code.go;
}
---

<FlowDiagramIsland client:visible diagram={diagram} codePython={codePython} codeGo={codeGo} mode={mode} />
