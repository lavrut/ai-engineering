---
import '../styles/tokens.css';

interface Props {
  title?: string;
}

const { title = 'AI Engineering' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="claude:viewport-fit-sides" content="cover" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <div class="app">
      <aside class="app-sidebar">
        <slot name="sidebar" />
      </aside>
      <main class="app-main" id="main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
    color: var(--ink);
  }
  h1 {
    font-size: var(--text-h1);
    letter-spacing: -0.02em;
  }
  h2 {
    font-size: var(--text-h2);
    letter-spacing: -0.015em;
  }
  h3 {
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  a {
    color: var(--accent);
    text-underline-offset: 0.18em;
  }

  code,
  kbd,
  pre {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  [hidden] {
    display: none !important;
  }

  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .muted {
    color: var(--muted);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 1px 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.6;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    white-space: nowrap;
  }

  .button-primary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .button-primary:hover {
    text-decoration: underline;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .prose > * {
    max-width: 68ch;
  }

  /* ── Shell layout ─────────────────────────────── */
  .app {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    min-height: 100vh;
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
  }
  .app-sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    overflow-y: auto;
    border-right: 1px solid var(--line);
    padding: 28px 24px 28px 8px;
  }
  .app-main {
    min-width: 0;
    padding: 48px 16px 96px 48px;
  }
  .app-main > [data-view] {
    max-width: var(--prose-w);
  }

  /* ── Sidebar ──────────────────────────────────── */
  .sidebar-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .wordmark {
    display: grid;
    gap: 2px;
    color: var(--ink);
    text-decoration: none;
  }
  .wordmark-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .wordmark-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .sidebar-toggle {
    display: none;
    min-height: 40px;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: 500 var(--text-small) / 1 var(--font-body);
    cursor: pointer;
  }
  .sidebar-nav {
    margin-top: 32px;
  }
  .nav-tracks,
  .nav-lessons,
  .nav-subs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-tracks {
    display: grid;
    gap: 20px;
  }
  .nav-track-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .is-planned .nav-track-title {
    color: var(--muted);
    font-weight: 500;
  }
  .nav-pct {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted);
  }
  .nav-lessons {
    margin-top: 8px;
    display: grid;
  }
  .nav-lesson {
    display: grid;
    grid-template-columns: 2.5ch 1fr 1.25em;
    gap: 8px;
    align-items: baseline;
    padding: 6px 8px;
    margin: 0 -8px;
    border-radius: var(--radius);
    color: var(--ink);
    font-size: var(--text-small);
    line-height: 1.4;
    text-decoration: none;
  }
  .nav-lesson:hover {
    background: var(--surface-2);
  }
  .nav-lesson[aria-current='page'] {
    background: var(--surface-2);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .nav-num {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted);
  }
  .nav-tick {
    color: var(--good);
    text-align: right;
  }
  .nav-subs {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    display: grid;
    gap: 2px;
  }

  /* ── Narrow screens: sidebar becomes a top disclosure ── */
  @media (max-width: 759.98px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }
    .app-sidebar {
      position: static;
      height: auto;
      overflow: visible;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 16px 0;
    }
    .app-main {
      padding: 32px 0 72px;
    }
    .sidebar-toggle {
      display: inline-flex;
      align-items: center;
    }
    .sidebar[data-open='false'] .sidebar-nav {
      display: none;
    }
    .sidebar-nav {
      margin-top: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
