---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'AI Engineering' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="claude:viewport-fit-sides" content="cover" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%232D56D6'/%3E%3C/svg%3E"
    />
    <script is:inline>
      // Apply the reader's theme before first paint (mirrors lib/theme.ts).
      // A theme the host already set is kept so "Auto" can return to it.
      (function () {
        var root = document.documentElement;
        var host = root.getAttribute('data-theme');
        if (host) root.setAttribute('data-host-theme', host);
        try {
          var t = localStorage.getItem('aie:theme');
          if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <div class="app">
      <aside class="app-sidebar">
        <slot name="sidebar" />
      </aside>
      <main class="app-main" id="main">
        <slot />
      </main>
    </div>
  </body>
</html>
