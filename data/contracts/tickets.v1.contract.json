{
 "consumers": [
  {
   "name": "mcp-read-server",
   "reads": "llms/data/tickets.jsonl via mcp/core/python/lumen_core/tickets.py",
   "version": "1"
  },
  {
   "name": "agents-eval",
   "reads": "llms/data/tickets.jsonl via agents/desk/python/desk_core.py",
   "version": "1"
  }
 ],
 "info": {
  "dataset": "llms/data/tickets.jsonl",
  "description": "Lumen support tickets, one per line, with a gold category and priority and a dev/test split.",
  "id": "tickets.v1",
  "owner": "llms",
  "status": "deprecated",
  "sunset": "2027-01-31",
  "version": "1"
 },
 "quality": {
  "enum_coverage": [
   "category",
   "priority"
  ],
  "row_count": {
   "max": 60,
   "min": 60
  },
  "unique": [
   "id"
  ]
 },
 "schema": {
  "fields": [
   {
    "meaning": "the ticket's stable key, t001 to t060; consumers look tickets up by it",
    "name": "id",
    "pattern": "^t\\d{3}$",
    "required": true,
    "type": "string"
   },
   {
    "meaning": "the customer's message, verbatim",
    "name": "text",
    "required": true,
    "type": "string"
   },
   {
    "enum": [
     "billing",
     "bug",
     "account",
     "feature_request",
     "how_to",
     "outage"
    ],
    "meaning": "the gold label a classifier is scored against",
    "name": "category",
    "required": true,
    "type": "string"
   },
   {
    "enum": [
     "low",
     "normal",
     "high",
     "urgent"
    ],
    "meaning": "the gold urgency of the ticket",
    "name": "priority",
    "required": true,
    "type": "string"
   },
   {
    "meaning": "free-form labels, often empty (the contract checks the array, not its items)",
    "name": "tags",
    "required": true,
    "type": "array"
   },
   {
    "enum": [
     "dev",
     "test"
    ],
    "meaning": "dev tickets tune prompts, test tickets score them; never mixed",
    "name": "split",
    "required": true,
    "type": "string"
   }
  ]
 },
 "servicing": {
  "freshness": {
   "max_age_days": 365
  }
 }
}
