                "required": [
                  "id"
                ],
                "title": "get_ticketArguments"
              },
              "name": "get_ticket",
              "outputSchema": {
                "properties": {
                  "id": {
                    "title": "Id",
                    "type": "string"
                  },
                  "category": {
                    "title": "Category",
                    "type": "string"
                  },
                  "priority": {
                    "title": "Priority",
                    "type": "string"
                  },
                  "untrusted_body": {
