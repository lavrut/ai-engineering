                "required": [
                  "id",
                  "category",
                  "priority",
                  "untrusted_body"
                ],
                "title": "Hit",
                "type": "object"
              }
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
              "description": "Classify a complaint text with the production model (a complaint product, not a ticket category).",
              "inputSchema": {
                "type": "object",
                "properties": {
                  "text": {
                    "title": "Text",
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "title": "classify_complaintArguments"
              },
              "name": "classify_complaint",
              "outputSchema": {
                "properties": {
                  "label": {
                    "title": "Label",
                    "type": "string"
                  },
                  "scores": {
                    "additionalProperties": {
                      "type": "number"
                    },
                    "title": "Scores",
                    "type": "object"
                  },
                  "low_confidence": {
                    "title": "Low Confidence",
                    "type": "boolean"
                  },
                  "model_version": {
                    "title": "Model Version",
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "scores",
                  "low_confidence",
                  "model_version"
                ],
                "title": "ClassifyOut",
                "type": "object"
              }
            }
