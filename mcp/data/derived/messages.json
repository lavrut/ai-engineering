                "$defs": {
                  "Hit": {
                    "properties": {
                      "id": {
                        "title": "Id",
                        "type": "string"
                      },
                      "category": {
                        "title": "Category",
                        "type": "string"
                      },
                      "priority": {
                        "title": "Priority",
                        "type": "string"
                      },
