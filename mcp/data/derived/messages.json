                    "title": "Hit",
                    "type": "object"
                  }
                },
                "properties": {
                  "results": {
                    "items": {
                      "$ref": "#/$defs/Hit"
                    },
                    "title": "Results",
                    "type": "array"
                  }
                },
                "required": [
                  "results"
                ],
                "title": "SearchOut",
                "type": "object"
              }
            },
            {
              "annotations": {
                "readOnlyHint": true
              },
