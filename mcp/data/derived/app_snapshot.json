  "mimeType": "text/html;profile=mcp-app",
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>Label a ticket</title>\n<style>\n  :root { --bg: #ffffff; --fg: #1a1a1a; --muted: #555555; --line: #767676; --accent: #0b57d0; --accent-fg: #ffffff; --ok: #0a5c2e; --bad: #8c1d18; }\n  @media (prefers-color-scheme: dark) {\n    :root { --bg: #1b1b1d; --fg: #ececec; --muted: #b0b0b0; --line: #8a8a8a; --accent: #8ab4f8; --accent-fg: #101010; --ok: #7ed9a0; --bad: #ff9c94; }\n  }\n  body { margin: 0; padding: 16px; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; }\n  h1 { font-size: 1.1rem; margin: 0 0 12px; }\n  dl { margin: 0 0 12px; display: grid; grid-template-columns: max-content 1fr; gap: 4px 12px; }\n  dt { color: var(--muted); }\n  dd { margin: 0; font-weight: 600; }\n  label { display: block; margin-bottom: 4px; }\n  select, button { font: inherit; padding: 8px 12px; border: 2px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }\n  button.primary { background: var(--accent); color: var(--accent-fg); border-color: var(--accent); }\n  button:disabled { opacity: 0.6; cursor: not-allowed; }\n  :focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }\n  .row { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; }\n  #status { margin-top: 12px; min-height: 1.5em; padding: 4px 0; }\n  #status[data-kind=\"ok\"]::before { content: \"Done: \"; color: var(--ok); font-weight: 700; }\n  #status[data-kind=\"error\"]::before { content: \"Error: \"; color: var(--bad); font-weight: 700; }\n  #status[data-kind=\"wait\"]::before { content: \"Working: \"; font-weight: 700; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Label a ticket</h1>\n  <dl>\n    <dt>Ticket</dt><dd id=\"ticket\">(waiting for the host)</dd>\n    <dt>Proposed label</dt><dd id=\"proposed\">(none)</dd>\n  </dl>\n  <label for=\"category\">Category</label>\n  <select id=\"category\" name=\"category\">\n    <option value=\"billing\">billing</option>\n    <option value=\"bug\">bug</option>\n    <option value=\"account\">account</option>\n    <option value=\"how_to\">how_to</option>\n    <option value=\"feature_request\">feature_request</option>\n    <option value=\"outage\">outage</option>\n  </select>\n  <div class=\"row\">\n    <button type=\"button\" id=\"confirm\" class=\"primary\" disabled>Confirm</button>\n    <button type=\"button\" id=\"cancel\" disabled>Cancel</button>\n  </div>\n  <p id=\"status\" role=\"status\" aria-live=\"polite\"></p>\n</main>\n<script>\n\"use strict\";\n// The host<->App protocol is JSON-RPC 2.0 over postMessage (MCP Apps, spec version 2026-01-26).\n// Nothing is bundled: this speaks the handful of methods it needs directly.\n//\n// Confirm does NOT write anything itself. It asks the host to run tools/call on label_ticket, and\n// the server then runs its own elicitation round (the host shows the user the question). A button in\n// this page therefore never bypasses the server's confirmation.\nvar PROTOCOL_VERSION = \"2026-01-26\";\nvar TOOL = \"label_ticket\";\nvar nextId = 1;\nvar pending = {};\nvar ticketId = null;\nvar busy = false;\nvar el = {\n  ticket: document.getElementById(\"ticket\"), proposed: document.getElementById(\"proposed\"),\n  category: document.getElementById(\"category\"), confirm: document.getElementById(\"confirm\"),\n  cancel: document.getElementById(\"cancel\"), status: document.getElementById(\"status\")\n};\n\nfunction send(msg) {\n  // The host's origin is not known to a sandboxed page, so the target is \"*\"; incoming messages are\n  // accepted only from window.parent.\n  window.parent.postMessage(msg, \"*\");\n}\nfunction request(method, params) {\n  return new Promise(function (resolve, reject) {\n    var id = nextId++;\n    pending[id] = { resolve: resolve, reject: reject };\n    send({ jsonrpc: \"2.0\", id: id, method: method, params: params });\n  });\n}\nfunction notify(method, params) { send({ jsonrpc: \"2.0\", method: method, params: params }); }\nfunction say(kind, text) { el.status.dataset.kind = kind; el.status.textContent = text; }\nfunction setBusy(b) {\n  busy = b;\n  el.confirm.disabled = b || ticketId === null;\n  el.cancel.disabled = b || ticketId === null;\n  el.category.disabled = b;\n}\nfunction resultText(result) {\n  var c = result && result.content && result.content[0];\n  return c && typeof c.text === \"string\" ? c.text : \"\";\n}\n\nfunction onToolInput(params) {\n  var args = (params && params.arguments) || {};\n  if (typeof args.id !== \"string\") return;\n  ticketId = args.id;\n  el.ticket.textContent = args.id;\n  if (typeof args.label === \"string\") {\n    el.proposed.textContent = args.label;\n    for (var i = 0; i < el.category.options.length; i++) {\n      if (el.category.options[i].value === args.label) el.category.selectedIndex = i;\n    }\n  }\n  setBusy(false);\n  say(\"\", \"Choose a category, then Confirm. The server will ask you to confirm again before it writes.\");\n}\nfunction onToolResult(params) {\n  if (!params) return;\n  if (params.isError) say(\"error\", resultText(params) || \"The tool reported an error.\");\n  else if (params.structuredContent && params.structuredContent.written) {\n    say(\"ok\", \"Ticket \" + params.structuredContent.ticket_id + \" labelled \" + params.structuredContent.label + \".\");\n  }\n}\n\nel.confirm.addEventListener(\"click\", function () {\n  if (busy || ticketId === null) return;\n  setBusy(true);\n  say(\"wait\", \"Waiting for you to confirm in the host...\");\n  request(\"tools/call\", { name: TOOL, arguments: { id: ticketId, label: el.category.value } })\n    .then(function (result) {\n      if (result && result.isError) say(\"error\", resultText(result) || \"The label was not written.\");\n      else onToolResult(result);\n    })\n    .catch(function (e) { say(\"error\", (e && e.message) || \"The call failed.\"); })\n    .then(function () { setBusy(false); });\n});\nel.cancel.addEventListener(\"click\", function () {\n  ticketId = null;\n  setBusy(true);\n  say(\"\", \"Cancelled. Nothing was written.\");\n});\n\nwindow.addEventListener(\"message\", function (event) {\n  if (event.source !== window.parent) return;\n  var m = event.data;\n  if (!m || m.jsonrpc !== \"2.0\") return;\n  if (m.method === undefined && m.id !== undefined && pending[m.id]) {  // a response to our request\n    var p = pending[m.id];\n    delete pending[m.id];\n    if (m.error) p.reject(new Error(m.error.message || \"request failed\")); else p.resolve(m.result);\n    return;\n  }\n  if (m.method === \"ui/notifications/tool-input\") onToolInput(m.params);\n  else if (m.method === \"ui/notifications/tool-result\") onToolResult(m.params);\n  else if (m.method === \"ping\" && m.id !== undefined) send({ jsonrpc: \"2.0\", id: m.id, result: {} });\n  else if (m.method === \"ui/resource-teardown\" && m.id !== undefined) send({ jsonrpc: \"2.0\", id: m.id, result: {} });\n});\n\nrequest(\"ui/initialize\", {\n  appInfo: { name: \"lumen-label\", version: \"1.0.0\" }, appCapabilities: {}, protocolVersion: PROTOCOL_VERSION\n}).then(function () { notify(\"ui/notifications/initialized\", {}); })\n  .catch(function () { say(\"error\", \"Could not reach the host.\"); });\n</script>\n</body>\n</html>\n",
  "sample_tool_input": {
    "name": "label_ticket",
    "arguments": {
      "id": "t001",
      "label": "billing"
    }
